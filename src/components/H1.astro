---
type Props = {
    text: string;
    textColor?: string;
};

const { text, textColor = "text-white" } = Astro.props;
---

<h1
    class=`text-4xl ${textColor} font-next-art font-bold mb-3 text-center uppercase`
    style="text-shadow: 0.5px 0.5px 0.5px rgba(188, 188, 188, 0.801);"
>
    {text}
</h1>
