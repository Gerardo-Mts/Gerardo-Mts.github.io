---
type Props = {
    text: string;
    colorClass?: string;
    class?: string;
};

const { text, colorClass = "bg-vividGreen", class: className = "" } = Astro.props;
---

<button
    class:list={[`${colorClass} hover:bg-green-700 text-white font-bold py-2 px-4 rounded-full uppercase`, className]}>
    {text}
</button>