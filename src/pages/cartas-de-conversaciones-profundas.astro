---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import Button from "../components/Button.astro";
import H1 from "../components/H1.astro";
// Import an image from your public folder
import { Image } from "astro:assets";
import cardMain from "../../public/assets/cartasProfundas/cardMainSection.webp";
import cardSectionOne from "../../public/assets/cartasProfundas/cardSectionOne.webp";
import cardSectionTwo from "../../public/assets/cartasProfundas/cardSectionTwo.webp";

import Footer from "../components/Footer.astro";
// Elimina el comentario (//) de la siguiente línea para importar el componente de video
// import YouTubeVideo from "../components/YouTubeVideo.astro";
---

<!-- #F0E6CC, #F0E4D1 -->
<div class="bg-custom-white-beige">
  <Layout title="Cartas de conversaciones profundas">
    <Main>
      <div class="custom-bg px-10 py-2 rounded-lg text-center">
        <H1
          text="Cartas de conversaciones profundas"
          textColor="text-red-love"
        />

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <Image
            class="w-full sm:w-4/5 md:w-7/12 lg:w-7/12 xl:w-7/12 h-auto object-contain sm:mx-11 aspect-w-4 aspect-h-3 rounded-lg"
            src={cardMain}
            alt="Cartas de conversaciones profundas"
          />
        </div>

        <!-- Ejemplo de video, elimina las flechas del inicio y final para aplicarlo  -->
        <!-- <div class="text-white text-center max-w-4xl mx-auto px-4">
          <div class="mx-auto my-6">
            <YouTubeVideo
              id="lhi1UQJwV6Y"
              title="Video Title"
              width={800}
              height={450}
              autoplay={true}
            />
          </div>
        </div> -->

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <p>
            Cartas de conversaciones profundas que fortaleceran y reparan tu
            relacion en pareja, comprarlas ya y habla ahora mismo con Gerardo
            Miramontes
          </p>
        </div>

        <Button
          href="https://api.whatsapp.com/send?phone=+523333032063"
          text="Comprar ahora"
          textColor="text-red-love"
          colorClass="bg-custom-white-beige"
          hoverColor="hover:bg-gray-100"
          borderColor="border-red-love"
          bgColor="bg-custom-white-beige"
        />

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <p>Nuestros testimonios hablan por si solos</p>
        </div>

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <Image
            class="w-full sm:w-4/5 md:w-7/12 lg:w-7/12 xl:w-7/12 h-auto object-contain sm:mx-11 aspect-w-4 aspect-h-3 rounded-lg"
            src={cardSectionOne}
            alt="Cartas de conversaciones profundas"
          />
        </div>

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <p>Mejora desde la primera prueba tus relaciones personales</p>
        </div>

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <Image
            class="w-full sm:w-4/5 md:w-7/12 lg:w-7/12 xl:w-7/12 h-auto object-contain sm:mx-11 aspect-w-4 aspect-h-3 rounded-lg"
            src={cardSectionTwo}
            alt="Cartas de conversaciones profundas"
          />
        </div>

        <div class="flex justify-center m-5 mx-2 sm:mx-11">
          <p>Pruebalas ahora y tu vida cambiara!</p>
        </div>

        <Button
          href="https://api.whatsapp.com/send?phone=+523333032063"
          text="Comprar ahora"
          textColor="text-red-love"
          colorClass="bg-custom-white-beige"
          hoverColor="hover:bg-gray-100"
          borderColor="border-red-love"
          bgColor="bg-custom-white-beige"
        />
      </div>
    </Main>
  </Layout>
</div>

<!-- @ts-ignore -->
<style global>
  /* Target the footer and all its child elements */
  .custom-footer,
  .custom-footer * {
    color: black !important;
  }
</style>
