---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import Button from "../components/Button.astro";
import H1 from "../components/H1.astro";
// Import an image from your public folder
// import { Image } from "astro:assets";
// import cardMain from "../../public/assets/cartasProfundas/cardMainSection.webp";
// import cardSectionOne from "../../public/assets/cartasProfundas/cardSectionOne.webp";
// import cardSectionTwo from "../../public/assets/cartasProfundas/cardSectionTwo.webp";

// import Footer from "../components/Footer.astro";
// Elimina el comentario (//) de la siguiente línea para importar el componente de video
import YouTubeVideo from "../components/YouTubeVideo.astro";
---

<div>
  <Layout title="¡ESO ES TODO!">
    <Main>
      <div class="custom-bg px-5 py-2 rounded-lg text-center">
        <H1 text="¡ESO ES TODO!" />

        <div class="flex flex-col justify-center m-5 mx-2 sm:mx-11">
          <p class="text-lg text-white">
            Por ultimo mira este video porque <b class="text-green-500"
              >TE REGALE</b
            > 🎁 una
            <strong class="text-green-500"
              >SESION 1 a 1 conmigo de 30 minutos</strong
            >
            completamente GRATIS y enfocada solamente en ti para ayudarte a <b>identificar
            qué herida lleva saboteando tus relaciones por años.</b>
          </p>
        </div>
        <p class="text-lg text-white mt-4">
          En esta misma sesión te pasare personalmente la información de <b
            >que</b
          >
          <strong class="text-green-500">PRECIO</strong>
          <b>tiene el BOLETO al taller y que incluye,</b> así que mira este video
          para que sepas como tendremos <b>nuestra sesión:</b>
        </p>
      </div>
      <div class="text-white text-center max-w-4xl mx-auto px-4">
        <div class="mx-auto my-6">
          <vturb-smartplayer
            id="vid-690270fe8687c6f8d6f2d177"
            style="display: block; margin: 0 auto; width: 100%; "
          ></vturb-smartplayer>
          <script type="text/javascript">
            var s = document.createElement("script");
            (s.src =
              "https://scripts.converteai.net/8397ee7e-5b34-4380-8288-000d65b1f3f4/players/690270fe8687c6f8d6f2d177/v4/player.js"),
              (s.async = !0),
              document.head.appendChild(s);
          </script>
        </div>
      </div>

      <div
        class="custom-bg px-6 sm:px-10 py-8 rounded-lg text-center mt-8 text-white"
      >
        <h2 class="text-3xl font-bold text-red-600 uppercase mb-6">
          Ultimas Instrucciones:
        </h2>
        <div class="max-w-3xl mx-auto space-y-5 text-lg">
          <p>
            Como te menciono ya tenemos <strong class="text-red-600"
              >CUPOS MUY LIMITADOS</strong
            >
          </p>
          <p>
            Así que en cuanto veas que te llame o mande un mensaje un numero que
            comienza con:
            <strong class="text-2xl block my-2 tracking-widest">"33"</strong>
          </p>
          <p>
            No te asustes y <strong>CONTESTA somos nosotros,</strong> en
            <strong>Guadalajara</strong> los números comienzan con <strong
              >33</strong
            >.
          </p>
          <p>
            Si no contestas rápido puede que no tengamos nuestra sesion gratis y
            que
            <strong class="block text-xl uppercase mt-3"
              >QUEDES FUERA Y PIERDAS TU LUGAR EN EL TALLER PORQUE QUEDAN POCOS
              ACCESOS</strong
            >
          </p>
        </div>
        <div class="mt-14">
          <a
            href="https://api.whatsapp.com/send?phone=+523317159215&text=Hola%20Ángel,%20me%20ayudas%20a%20agendar%20mi%20sesión%20GRATIS%20con%20Gerardo%20para%20identificar%20mi%20herida%20y%20que%20me%20pase%20la%20información%20sobre%20el%20taller%20de%20las%205%20heridas%20del%20alma%20❤️‍🩹%20este%2012%20de%20Diciembre%20en%20CDMX%20por%20favor?%20🙏🏻"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-4 px-8 py-4 bg-green-500 rounded-full text-white shadow-lg transition-transform transform hover:scale-105"
          >
            <div>
              <span class="block text-left text-base"
                >O habla <b class="text-red-600">URGENTEMENTE</b> con <b
                  >Angel en WhatsApp</b
                ></span
              >
              <span class="block text-left"
                >para que <b>AGENDE NUESTRA SESIÓN</b> lo antes posible</span
              >
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentColor"
              class="bi bi-whatsapp"
              viewBox="0 0 16 16"
            >
              <path
                d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.068-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </Main>
  </Layout>

  <!-- @ts-ignore -->
  <style global>
    /* Target the footer and all its child elements */
    .custom-footer,
    .custom-footer * {
      color: black !important;
    }
  </style>
</div>
