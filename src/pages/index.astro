---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Button from "../components/Button.astro";
import Form from "../components/Form.astro";
import FeatureSection from "../components/FeatureSection.astro";
import YouTubeVideo from "../components/YouTubeVideo.astro";

// import the Image component from Astro and the main landing page image
import { Image } from "astro:assets";
import mainLandingPage from "../../public/assets/mainLandingPage.webp";

// Feature Section Image Imports
import featureSectionOne from "../../public/assets/featureSectionOne.webp";
import featureSectionTwo from "../../public/assets/featureSectionTwo.webp";
import featureSectionThree from "../../public/assets/featureSectionThree.webp";
import projectLogo from "../../public/assets/projectLogo.webp";
---

<Layout title="Gerardo Miramontes">
  <Main>
    <!-- H1 : Es el titulo de la pagina, cambialo para actualizarlo -->
    <h1
      class=`text-4xl text-white font-next-art font-bold mb-3 text-center uppercase`
      style="text-shadow: 0.5px 0.5px 0.5px rgba(188, 188, 188, 0.801);"
    >
      TALLER VIVENCIAL: <strong class="text-red-love"
        >LAS 5 HERIDAS DEL ALMA QUE ARRUINAN TUS RELACIONES</strong
      >
    </h1>

    <!-- Subtitulo de la pagina -->
    <p class="text-white text-center text-2xl p-3">
      <b>Un taller íntimo</b> donde descubrirás lo que ha bloqueado el flujo del
      <b>amor real</b> que has <b>deseado por años en tus relaciones</b>.
    </p>

    <p class="text-white text-center text-2xl p-3">
      Viernes 12 y Sábado 13 de Diciembre 2025 📍CD<b>MX</b>
    </p>

    <!-- Imagen de bienvenida -->
    <!-- <div class="text-white text-center max-w-4xl mx-auto px-4">
      <div class="mx-auto my-6">
        <YouTubeVideo
          id="pzuGzEpAK3Y"
          title="Video Title"
          width={800}
          height={450}
          autoplay={true}
        />
      </div>
    </div> -->

    <div class="text-white text-center max-w-4xl mx-auto px-4">
      <div class="mx-auto my-6">
        <vturb-smartplayer
          id="vid-68f7f3938adf97fbc6a165ac"
          style="display: block; margin: 0 auto; width: 100%;"
        ></vturb-smartplayer>
        <script type="text/javascript">
          var s = document.createElement("script");
          s.src =
            "https://scripts.converteai.net/8397ee7e-5b34-4380-8288-000d65b1f3f4/players/68f7f3938adf97fbc6a165ac/v4/player.js";
          s.async = true;
          document.head.appendChild(s);
        </script>
      </div>
    </div>

    <!-- Ejemplo para agregar imagen en lugar de video -->
    <!-- <div class="flex justify-center mt-10 mx-2 sm:mx-11">
      <Image
        class="w-full sm:w-4/5 md:w-7/12 lg:w-7/12 xl:w-7/12 h-auto object-contain sm:mx-11 aspect-w-4 aspect-h-3 rounded-lg"
        src={mainLandingPage}
        alt="Gerardo Miramontes Main Landing Page Image"
      />
    </div> -->

    <!-- Boton de registro -->
    <!-- id="showFormButton" -->
    <div class="flex flex-col justify-center items-center mt-10 mx-4 space-y-4">
      <!-- Cambiar texto del boton de registro aqui abajo -->
      <Button
        text="❤️‍🩹 QUIERO MÁS INFORMACIÓN"
        colorClass="bg-custom-orange"
        hoverColor="bg-custom-orange"
        href="/sucess"
      />
    </div>

    <div id="registrationForm" class="hidden">
      <Form />
    </div>

    <!-- Seccion de caracteristicas -->
    <!-- Features section -->
    <br />
    <FeatureSection
      heading="¿Qué es esto y que incluye? 💌"
      imageSrc={featureSectionOne}
      imageDescription="Gerardo Miramontes Main Landing Page Image"
      htmlContent={`
        <h3 class="text-green-400">El acceso al taller tiene 2 modalidades:</h3>
        <ol class="list-decimal pl-5 pt-3 space-y-2">
          <li class="space-y-3">
            <b>❤️ CÍRCULO TALLER — Acceso General</b>
            <p class="mb-3">Ideal para quienes quieren dar el <b>primer paso</b> a entender su historia y <b>por lo tanto transformar sus relaciones.</b></p>
            <p class="font-bold text-green-400">✅ INCLUYE</p>
            <ul class="list-disc pl-5 space-y-2 mt-2">
              <li>🎟️ Acceso al taller vivencial "<b>Las 5 heridas del alma que arruinan tus relaciones</b>" (viernes 12 de diciembre 2025).</li>
              <li>📕 Material de trabajo exclusivo para acompañarte paso a paso.</li>
              <li>🧭 <b>10 semanas de seguimiento en vivo</b> conmigo después del evento.</li>
              <li>🫂 Acceso a comunidad privada de apoyo y transformación.</li>
              <li>🎁 <b>Bono especial</b>: descuento único para mi evento anual de planeación de metas y relaciones (3 enero 2026 - Hotel RIU <b>Guadalajara</b>).</li>
              <li>📸 Foto conmemorativa y firma de material al final del evento.</li>
            </ul>
          </li>
          
          <li class="space-y-3 pt-4">
            <b>❤️‍🔥 Círculo de Conexión Eterna — VIP</b>
            <p class="mb-3">La experiencia <b>EXCLUSIVA</b> para quienes desean que <b>YO</b> los guíe y <b>acompañe de la mano</b> 1 a 1 a descubrir personalmente la raíz que provoca que tus <b>relaciones fracasen</b>. 💔</p>
            <p class="font-bold text-green-400">✅ Incluye todo lo anterior, más:</p>
            <ul class="list-disc pl-5 space-y-2 mt-5">
              <li>🌇 <b>Charla privada (solo 15 personas)</b> el sábado 13 de diciembre a las <b>5:00 pm:</b> <b class="text-red-600">"No confundas al amor de tu vida con el amor de tus días"</b> En un rooftop con vista a la <b>Torre Latinoamericana</b>, fuera de un escenario, en un espacio íntimo para que me preguntes todo lo que necesites.</li>
              <li>🥐 <b>Desayuno VIP:</b> trabajo <b>enfocado 100% en ti.</b> Usaremos técnica de <b>mayéutica, egograma, ejercicios escritos</b> y toda mi <b>experiencia</b> y <b>atención</b> solo en <b>ti</b> y un grupo aún mas <b>reducido y exclusivo</b>.</li>
            </ul>
          </li>
        </ol>
      `}
    />

    <div class="flex flex-col justify-center items-center mb-6 mx-4 space-y-4">
      <!-- Cambiar texto del boton de registro aqui abajo -->
      <Button
        text="❤️‍🩹 QUIERO MÁS INFORMACIÓN"
        colorClass="bg-custom-orange"
        hoverColor="bg-custom-orange"
        href="/sucess"
      />
    </div>

    <FeatureSection
      heading="¿Qué vas a APRENDER y SANAR en este taller y cual es mi Metodología? ❤️‍🩹"
      imageSrc={featureSectionTwo}
      imageDescription="Gerardo Miramontes Main Landing Page Image"
      htmlContent={`
        <p>A través de mi <b>método único</b> de 7 pasos llamada: “<b>De la curva del Quiebre a la Conexión</b>.</p>
        <br>
        <p>Vamos a:</p>
        <ol class="list-decimal pl-5 pt-3 space-y-2">
          <li><b>Descubrir el origen de tus heridas.</b></li>
          <li><b>Cortar los patrones que repites una y otra vez.</b></li>
          <li><b>Y reescribir tu narrativa para dejar de relacionarte desde la escasez y abrirte al amor real.</b></li>
        </ol>
        <br>
        <p>Este taller no es otro <b>discurso romántico de TikTok</b> ni de frases vacías <b>de moda</b> sobre “<b>amor propio</b>”, o  consejos reciclados de todos los que hablan de amor en <b>redes sociales</b>.</p>
        <br>
        <p>Es un proceso real, profundo y probado, que ha transformado la manera en que muchas personas <b>se ven y se aman</b>. La mayoría llegó <b>con dudas</b>, y salió con un antes y un después en <b>su forma de amar</b>.</p>
        <br>
        <p>💔 <b>¿Cómo saber si este taller es para ti?</b></p>
        <br>
        <ul class="list-disc pl-5 pt-3 space-y-2">
          <li>Si vives con miedo a <b>NO ENCONTRAR</b> o perder <b>UNA RELACIÓN</b>. <b>Es para ti</b> ✅</li>
          <li>Si cargas <b>heridas no sanadas</b> de rupturas o familia. <b>Es para ti</b> ✅</li>
          <li>Si <b>repites patrones que bloquean la conexión contigo, tu familia, pretendientes o parejas</b>. <b>Es para ti</b> ✅</li>
        </ul>
      `}
    />

    <div class="flex flex-col justify-center items-center mb-6 mx-4 space-y-4">
      <!-- Cambiar texto del boton de registro aqui abajo -->
      <Button
        text="❤️‍🩹 QUIERO MÁS INFORMACIÓN"
        colorClass="bg-custom-orange"
        hoverColor="bg-custom-orange"
        href="/sucess"
      />
    </div>

    <FeatureSection
      heading="¿Quien soy?"
      imageSrc={featureSectionThree}
      imageDescription="Gerardo Miramontes Main Landing Page Image"
      htmlContent={`
        <p>Yo soy <b>Gerardo Miramontes</b>, y pase de vivir años donde mis propias heridas me llevaron a rupturas, vacíos y a perder 
        y alejar personas <b>con las que de verdad valía la pena compartir una vida</b>.</p>
        <br>
        <p>A impulsar actualmente a una comunidad de más de <b>190,000 seguidores</b> sumando todas mis redes sociales. Hombres y mujeres a los cuales por <b>mas de 5 años</b> he ayudado a <b>mejorar y sanar sus vínculos</b> para llegar a ese <b>punto de conexión e intimidad real</b> <b>con ellos mismos, sus familias y sus parejas</b>.</p>
        <br>
        <p>También he tenido la oportunidad de ser:</p>
        <br>
        <p><b class="text-red-600">TEDx</b> speaker y trabajar con grandes <b>Influencers, Artistas y figuras publicas</b> del mundo de los <b>negocios.</b></p>
        <br>
        <p>En Instagram me encuentras como: <b>@gerardo_miramontess</b></p>
      `}
    />

    <div class="flex flex-col justify-center items-center mb-6 mx-4 space-y-4">
      <!-- Cambiar texto del boton de registro aqui abajo -->
      <Button
        text="❤️‍🩹 QUIERO MÁS INFORMACIÓN"
        colorClass="bg-custom-orange"
        hoverColor="bg-custom-orange"
        href="/sucess"
      />
    </div>

    <!-- Seccion de testimonios con videos -->

    <div class="text-white text-center max-w-4xl mx-auto px-4">
      <!-- H2 : Es el titulo de la seccion superior de testimonios, cambialo para actualizarlo -->
      <H2
        text="Qué dicen las personas que ya han vivido esta experiencia y TRANSFORMADO sus RELACIONES y CONEXIONES:"
      />
      <div class="mx-auto my-6">
        <!-- Video de testimonio 1 -->
        <YouTubeVideo
          id="clHbYWmIH2A"
          title="Video Title"
          width={800}
          height={450}
          autoplay={false}
        />
      </div>

      <!-- <div class="mx-auto my-6"> -->
      <!-- Video de testimonio 2 -->
      <!-- <YouTubeVideo -->
      <!-- id="iVofKCfnIPU" -->
      <!-- title="Video Title" -->
      <!-- width={800} -->
      <!-- height={450} -->
      <!-- autoplay={false} -->
      <!-- /> -->
      <!-- </div> -->

      <!-- Es el titulo de la seccion inferior de testimonios, cambialo para actualizarlo  -->
      <p class="text-2xl">
        <b
          >Como te dije en el video, deja de buscar fuera lo que esta aqui
          adentro, cierra tu año diferente y ahorrate años de sufrimiento.</b
        >
      </p>
      <br />
      <p class="text-2xl">
        NO TE NIEGUES + <b>EL AMOR</b>, QUE POR DERECHO ES TUYO. <b
          >Ahí nos vemos.</b
        >
      </p>
    </div>

    <div class="mt-4 text-white">
      <div class="text-center px-4">
        <div class="flex justify-center">
          <Image
            src={projectLogo}
            alt="Logo Sensible no frágil"
            class="w-32 h-auto"
          />
        </div>
        <p class="text-xl tracking-wider">
          #SENSIBLE,<br />
          NO FRÁGIL
        </p>
      </div>
    </div>

    <!-- Form js -->
    <script>
      // Get all necessary elements
      const showFormButton = document.getElementById("showFormButton");
      const registrationForm = document.getElementById("registrationForm");
      const scrollTriggerButtons = document.querySelectorAll(".scroll-trigger");

      // Function to show form
      const showForm = () => {
        if (showFormButton && registrationForm) {
          showFormButton.classList.add("hidden");
          registrationForm.classList.remove("hidden");
        }
      };

      // Add click handler for main button
      if (showFormButton && registrationForm) {
        showFormButton.addEventListener("click", showForm);
      }

      // Add click handlers for all "Regístrate ahora" buttons
      scrollTriggerButtons.forEach((button) => {
        button.addEventListener("click", (e) => {
          e.preventDefault();

          // Show the form first
          showForm();

          // Add null check for registrationForm
          if (!registrationForm) return;

          // Calculate position to center the form in viewport
          const formRect = registrationForm.getBoundingClientRect();
          const absoluteFormTop = window.pageYOffset + formRect.top;
          const offset =
            absoluteFormTop - (window.innerHeight - formRect.height);

          // Scroll to the calculated position
          window.scrollTo({
            top: offset,
            behavior: "smooth",
          });
        });
      });
    </script>
  </Main>
</Layout>
