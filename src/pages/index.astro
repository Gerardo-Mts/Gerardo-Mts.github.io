---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import H1 from "../components/H1.astro";
import H2 from "../components/H2.astro";
import Button from "../components/Button.astro";
import Form from "../components/Form.astro";
import FeatureSection from "../components/FeatureSection.astro";
import YouTubeVideo from "../components/YouTubeVideo.astro";

// import the Image component from Astro and the main landing page image
import { Image } from "astro:assets";
import mainLandingPage from "../../public/assets/mainLandingPage.webp";

// Feature Section Image Imports
import featureSectionOne from "../../public/assets/featureSectionOne.webp";
import featureSectionTwo from "../../public/assets/featureSectionTwo.webp";
import featureSectionThree from "../../public/assets/featureSectionThree.webp";
---

<Layout title="Gerardo Miramontes">
  <Main>
    <!-- H1 : Es el titulo de la pagina, cambialo para actualizarlo -->
    <H1 text="Reto 2025 Sobrevive al futuro digital" />

    <!-- Subtitulo de la pagina -->
    <p class="text-white text-center text-2xl p-3">
      Jueves 23 de Enero del 2025 8:00 pm hora CDMX
    </p>

    <!-- Imagen de bienvenida -->
    <div class="flex justify-center mt-10 mx-2 sm:mx-11">
      <Image
        class="w-full sm:w-4/5 md:w-7/12 lg:w-7/12 xl:w-7/12 h-auto object-contain sm:mx-11 aspect-w-4 aspect-h-3 rounded-lg"
        src={mainLandingPage}
        alt="Gerardo Miramontes Main Landing Page Image"
      />
    </div>

    <!-- Boton de registro -->
    <div id="showFormButton" class="flex justify-center mt-10">
      <!-- Cambiar texto del boton de registro aqui abajo -->
      <Button
        text="Registar inmediatamente"
        colorClass="bg-custom-orange"
        hoverColor="bg-custom-orange"
      />
    </div>

    <div id="registrationForm" class="hidden">
      <Form />
    </div>

    <!-- Seccion de caracteristicas -->
    <!-- Features section -->
    <FeatureSection
      heading="¿Qué es esto?"
      imageSrc={featureSectionOne}
      imageDescription="Gerardo Miramontes Main Landing Page Image"
      htmlContent={`
				<p>
          Una clase GARTIS en línea para esos emprendedores, negocios, marcas personales, 
          coaches y creadores de contenido que están ESTANCADOS en redes sociales, en sus 
          VENTAS y tienen el gran problema de que en este Nuevo Mundo Digital las tendencias 
          van más rápido de lo que puedes adaptarte.
				</p>
			`}
      buttonText="Regístrate ahora"
    />

    <FeatureSection
      heading="¿Qué vas a aprender en el entrenamiento y cuál es esa Metodología?"
      imageSrc={featureSectionTwo}
      imageDescription="Gerardo Miramontes Main Landing Page Image"
      htmlContent={`
				<ul class="list-disc pl-5 pt-3 space-y-2">
					<li>
						⁠Aprenderás los 4 pilares de Instagram que para crear una marca personal exitosa.
					</li>
					<li>
						También aprenderás cómo hacer un embudo sencillo para transformar a tus seguidores 
            en clientes potenciales.
					</li>
					<li>
            Conocerás los errores comunes que matan tus ventas y engagement en redes sociales 
            (y cómo evitarlos).
					</li>
          <br>
          <p>
          En este entrenamiento de 1 hora aprenderás de la mano de Gerardo Miramontes y Chuy cómo 
          sobrevivir y permanecer vigente con tu negocio y marca personal en este nuevo FUTURO DIGITAL 
          que cambia constante y bruscamente en tendencias, gustos y modelos de negocio. 
          </p>
          <br>
          <p>
          Esto lo haremos a través de la metodología probada de Gerardo Miramontes que durante 5 años le 
          ha permitido crear una comunidad de 183,000 seguidores sumando todas sus redes sociales.
          </p>
				</ul>
			`}
      buttonText="Regístrate ahora"
    />

    <FeatureSection
      heading="¿Quienes somos?"
      imageSrc={featureSectionThree}
      imageDescription="Gerardo Miramontes Main Landing Page Image"
      htmlContent={`
				<p>
          Dos experimentados creadores de contenido en marketing emocional y ventas con 5 años de experiencia en el campo. 
				</p>
				<br>
				<p>
          Gerardo ha sido 2 veces invitado a las reuniones de creadores de contenido de TikTok, como también ha sido TEDx speaker. 🎤
				</p>
        <br>
        <p>
          Ha ayudado a marcas como Deco Expres a cerrar negocios con Santa Clara (una marca  de Coca-Cola), Carl’s Jr. 
          Farmacias Similares, Chivas F.C y más marcas importantes. 
        </p>
        <br>
        <p>
          Como así mismo ha tenido por 5 años una Marca Personal Fructífera en el mundo del desarrollo personal, brindándole así la 
          experiencia y el conocimiento del campo emocional y cómo este influye en las decisiones de compra y el marketing.
        </p>
			`}
      buttonText="Regístrate ahora"
    />

    <!-- Seccion de testimonios con videos -->

    <div class="text-white text-center max-w-4xl mx-auto px-4">
      <!-- H2 : Es el titulo de la seccion superior de testimonios, cambialo para actualizarlo -->
      <H2
        text="Lo que dicen las personas que ya vieron este workshop presencial"
      />
      <div class="mx-auto my-6">
        <!-- Video de testimonio 1 -->
        <YouTubeVideo
          id="boaQVannmKY"
          title="Video Title"
          width={800}
          height={450}
          autoplay={false}
        />
      </div>

      <div class="mx-auto my-6">
        <!-- Video de testimonio 2 -->
        <YouTubeVideo
          id="iVofKCfnIPU"
          title="Video Title"
          width={800}
          height={450}
          autoplay={false}
        />
      </div>

      <!-- Es el titulo de la seccion inferior de testimonios, cambialo para actualizarlo  -->
      <H2 text="¿Qué esperas para ser parte de esta experiencia?" />
    </div>
  </Main>
</Layout>

<!-- Form js -->
<script>
  // Get all necessary elements
  const showFormButton = document.getElementById("showFormButton");
  const registrationForm = document.getElementById("registrationForm");
  const scrollTriggerButtons = document.querySelectorAll(".scroll-trigger");

  // Function to show form
  const showForm = () => {
    if (showFormButton && registrationForm) {
      showFormButton.classList.add("hidden");
      registrationForm.classList.remove("hidden");
    }
  };

  // Add click handler for main button
  if (showFormButton && registrationForm) {
    showFormButton.addEventListener("click", showForm);
  }

  // Add click handlers for all "Regístrate ahora" buttons
  scrollTriggerButtons.forEach((button) => {
    button.addEventListener("click", (e) => {
      e.preventDefault();

      // Show the form first
      showForm();

      // Add null check for registrationForm
      if (!registrationForm) return;

      // Calculate position to center the form in viewport
      const formRect = registrationForm.getBoundingClientRect();
      const absoluteFormTop = window.pageYOffset + formRect.top;
      const offset = absoluteFormTop - (window.innerHeight - formRect.height);

      // Scroll to the calculated position
      window.scrollTo({
        top: offset,
        behavior: "smooth",
      });
    });
  });
</script>
