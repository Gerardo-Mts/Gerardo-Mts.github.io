---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import H3 from "../components/H3.astro";
import YouTubeVideo from "../components/YouTubeVideo.astro";
import Form from "../components/Form.astro";
import { Image } from "astro:assets";
import successPage from "../../public/assets/successPage.webp";
---

<Layout title="Registro Confirmado!">
  <Main>
    <div class="mx-3 rounded-lg text-center">
      <h3
        class="text-2xl text-white font-sans font-bold mb-5 text-center"
      >
        ❤️‍🩹 Muy bien <b>Sensible</b>, para pasarte <b>toda la información personalmente</b> sobre la entrada al taller y que incluye este <b>12</b> de <b>Diciembre</b> en <b>CDMX</b> compárteme tus datos en <b>este formulario ahí te mandare la información:</b>
      </h3>
    </div>
    <div class="text-white text-center max-w-4xl mx-auto px-4">
      <!-- <div class="mx-auto my-6">
        <YouTubeVideo
          id="hvo55kDSdEc"
          title="Video Title"
          width={800}
          height={450}
          autoplay={true}
        />
      </div> -->

      <div class="flex justify-center my-10 mx-2 sm:mx-11">
        <Image
          class="w-full sm:w-4/5 md:w-7/12 lg:w-7/12 xl:w-7/12 h-auto object-contain sm:mx-11 aspect-w-4 aspect-h-3 rounded-lg"
          src={successPage}
          alt="Gerardo Miramontes Main Landing Page Image"
        />
      </div>

      <div class="">
        <div class="text-center px-5 py-2">
          <p class="text-xl">❤️‍🩹<b>Círculo de la Reconexión y</b></p>
          <p class="text-xl">❤️‍🩹 <b>Círculo privado de Conexión Eterna</b></p>
          <br />
          <p class="text-xl">Compárteme tus datos en este formulario:</p>
        </div>

        <div>
          <Form />
        </div>
      </div>
    </div>
  </Main>
</Layout>
