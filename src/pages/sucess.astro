---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import H1 from "../components/H1.astro";
import YouTubeVideo from "../components/YouTubeVideo.astro";
import Button from "../components/Button.astro";
import { FaWhatsapp } from "react-icons/fa";
---

<Layout title="Registro Exitoso">
  <Main>
    <H1 text="¡Registro Exitoso!" />
    <div class="text-white text-center max-w-4xl mx-auto px-4">
      <p class="text-2xl pb-8">Gracias por registrarte</p>
      <div class="mx-auto my-6">
        <YouTubeVideo
          id="6fbGwYFbyIc"
          title="Video Title"
          width={800}
          height={450}
          autoplay={true}
        />
      </div>
    </div>

    <div class="text-white text-center max-w-4xl mx-auto px-4">
      <p class="text-2xl pb-8">Todavia te quedan dudas? Mandame un WhatsApp!</p>

      <Button
        href="https://wa.me/5491131234567"
        text="Conecta con Gerardo"
        icon={FaWhatsapp}
      />
    </div>
  </Main>
</Layout>
